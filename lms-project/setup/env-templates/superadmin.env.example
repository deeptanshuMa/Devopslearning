# Copy to lms-backend-super-admin-staging/app/.env and fill in real secrets.
PORT=3002

SWAGGER_BASE_URL=http://localhost:3002/
API_GATEWAY_URL=http://localhost:3000/

DB_USER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_PASSWORD=CHANGE_ME
DB_NAME=super_admin

JWT_SECRET=CHANGE_ME
JWT_EXPIRE="30D"

# Stripe product id referenced by the plans/subscription code
PRODUCT_ID=CHANGE_ME
ANANTA_LOGO=http://localhost:4000/logo.svg

# AWS (S3 file uploads, demo-sheet downloads, etc.)
AWS_BUCKET=CHANGE_ME
AWS_ACCESS_KEY=CHANGE_ME
AWS_SECRET_KEY=CHANGE_ME
AWS_REGION=CHANGE_ME
AWS_FILE_URL=CHANGE_ME

BASIC_AUTH_PASSWORD=CHANGE_ME

# Path used when generating/downloading demo sheets
SUPER_ADMIN_PATH=http://localhost:3002/
