# Copy to lms-backend-super-admin-staging/app/.env and fill in real secrets.
PORT=3002

SWAGGER_BASE_URL=http://localhost:3002/
API_GATEWAY_URL=http://localhost:3000/

DB_USER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_PASSWORD=CHANGE_ME
# If you're restoring the old CSV dump into a separate DB first (to verify
# before cutover), point this at e.g. super_admin_old_restore instead, then
# rename/repoint once verified. See import/OLD_DB_ANALYSIS.md.
DB_NAME=super_admin

JWT_SECRET=CHANGE_ME
JWT_EXPIRE="30D"

# Stripe product id referenced by the plans/subscription code
PRODUCT_ID=CHANGE_ME
ANANTA_LOGO=http://localhost:4000/logo.svg

# Object storage (S3 file uploads, demo-sheet downloads, etc.)
# NOTE: the code (utils/fileUploadHelper.js) builds its S3 client as
# `new AWS.S3({ accessKeyId, secretAccessKey, region })` with NO endpoint
# override. That only works against real AWS. If you're using an
# S3-compatible provider (e.g. UpCloud Object Storage), the helper needs a
# code change first — see fixes/NOTES.md item 7 for the exact patch —
# otherwise uploads will fail outright (the SDK will try a nonexistent
# `s3.<region>.amazonaws.com` host).
AWS_BUCKET=CHANGE_ME
AWS_ACCESS_KEY=CHANGE_ME
AWS_SECRET_KEY=CHANGE_ME
AWS_REGION=CHANGE_ME
AWS_FILE_URL=CHANGE_ME
# Only used after the fileUploadHelper.js patch below; leave unset for real AWS.
AWS_ENDPOINT=

BASIC_AUTH_PASSWORD=CHANGE_ME

# Path used when generating/downloading demo sheets
SUPER_ADMIN_PATH=http://localhost:3002/
