# Copy to lms-backend-notifications-staging/app/.env and fill in real secrets.
# NOTE: this service uses MongoDB, not Postgres (see 02-create-mongo-db.sh).
PORT=3005

SWAGGER_BASE_URL=http://localhost:3005/
API_GATEWAY_URL=http://localhost:3000/

JWT_SECRET=CHANGE_ME
DB_URL="mongodb://admin:CHANGE_ME@localhost:27017/notifications?authSource=admin"
LOCAL_BASEURL=http://localhost:3005/

EMAIL_USERNAME=CHANGE_ME
EMAIL_PASSWORD=CHANGE_ME
SEND_GRID_KEY=CHANGE_ME

BASIC_AUTH_PASSWORD=CHANGE_ME
