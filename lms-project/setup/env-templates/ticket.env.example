# Copy to lms-backend-ticket-staging/app/.env and fill in real secrets.
PORT=3004

SWAGGER_BASE_URL=http://localhost:3004/
API_GATEWAY_URL=http://localhost:3000/

DB_USER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_PASSWORD=CHANGE_ME
DB_NAME=tickets

JWT_SECRET=CHANGE_ME
JWT_EXPIRE="30D"

LOCAL_BASEURL=http://localhost:3001/
REACT_APP_BASE_URL=http://localhost:3004/

RABBITMQ_URL=amqp://localhost

# Object storage (S3 attachments)
# NOTE: utils/helpers/fileUploadHelper.js builds its S3 client as
# `new AWS.S3({ accessKeyId, secretAccessKey, region })` with NO endpoint
# override — only works against real AWS. Using an S3-compatible provider
# (e.g. UpCloud Object Storage) needs a code change first — see
# fixes/NOTES.md item 7 — otherwise uploads fail outright.
AWS_BUCKET=CHANGE_ME
AWS_ACCESS_KEY=CHANGE_ME
AWS_SECRET_KEY=CHANGE_ME
AWS_REGION=CHANGE_ME
AWS_FILE_URL=CHANGE_ME
# Only used after the fileUploadHelper.js patch below; leave unset for real AWS.
AWS_ENDPOINT=

BASIC_AUTH_PASSWORD=CHANGE_ME
