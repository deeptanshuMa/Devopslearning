# Copy to lms-backend-org-staging/app/.env and fill in real secrets.
PORT=3003

SWAGGER_BASE_URL=http://localhost:3003/
API_GATEWAY_URL=http://localhost:3000/

DB_USER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_PASSWORD=CHANGE_ME
DB_NAME=organization

JWT_SECRET=CHANGE_ME
JWT_EXPIRE="30D"

# AWS (S3 file uploads: assignments, salary slips, library, etc.)
AWS_BUCKET=CHANGE_ME
AWS_ACCESS_KEY=CHANGE_ME
AWS_SECRET_KEY=CHANGE_ME
AWS_REGION=CHANGE_ME
AWS_FILE_URL=CHANGE_ME

BASIC_AUTH_PASSWORD=CHANGE_ME

# Used when this service needs to call back into super-admin
SUPER_ADMIN_PATH=http://localhost:3002/
