# Copy to lms-backend-usermgmt-staging/app/.env and fill in real secrets.
PORT=3001

SWAGGER_BASE_URL=http://localhost:3001
API_GATEWAY_URL=http://localhost:3000/

DB_USER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_PASSWORD=CHANGE_ME
DB_NAME=user_management

JWT_SECRET=CHANGE_ME
JWT_EXPIRE=1d
LOCAL_BASEURL=http://localhost:3001
REACT_SUPER_ADMIN_APP_BASE_URL=http://localhost:4000
REACT_ORG_APP_BASE_URL=http://localhost:4001
NOTIFICATION_URL=http://localhost:3005/
REST_PASSWord_PATH=

RABBITMQ_URL=amqp://localhost

# Object storage (S3 file uploads) — required for profile pictures / attachments
# NOTE: utils/helpers/uploadFile.helper.js builds its S3 client as
# `new AWS.S3({ accessKeyId, secretAccessKey, region })` with NO endpoint
# override — only works against real AWS. Using an S3-compatible provider
# (e.g. UpCloud Object Storage) needs a code change first — see
# fixes/NOTES.md item 7 — otherwise uploads fail outright.
AWS_BUCKET=CHANGE_ME
AWS_ACCESS_KEY=CHANGE_ME
AWS_SECRET_KEY=CHANGE_ME
AWS_REGION=CHANGE_ME
AWS_FILE_URL=CHANGE_ME
# Only used after the uploadFile.helper.js patch below; leave unset for real AWS.
AWS_ENDPOINT=

BASIC_AUTH_PASSWORD=CHANGE_ME
